#!/bin/sh
# /etc/uci-defaults/bubbleui — runs once after the package is
# installed (or on first boot when shipped in an image). Idempotent;
# safe to re-run.
#
# Three jobs:
#   1. Generate the self-signed UI cert.
#   2. Open a port on the LAN-side firewall.
#   3. Reload nginx + firewall so the changes take effect.
#
# We don't write /etc/config/bubbleui here — it's shipped as a
# conffile, so the package installer drops it directly with the
# package's defaults.

set -e

# Everything we do here also goes to logread under tag `bubbleui` so
# `logread -e bubble` after first boot surfaces any failure instead
# of leaving us guessing why the UI wouldn't come up. (Earlier
# revisions of this script silently no-op'd if cert generation
# failed; that cost us a debugging cycle on real hardware.)
log() { logger -t bubbleui -p daemon.info "$*"; }
err() { logger -t bubbleui -p daemon.err  "$*"; }

log "uci-defaults start"

# 1. Self-signed cert with broad validity (DESIGN §6.6). openssl is
# our preferred tool because it's well-documented, stable across
# OpenWRT releases, and already on disk via libopenssl that nginx-ssl
# pulls in. px5g-mbedtls used to be the primary path but it silently
# no-ops on 25.x — even after switching the key type from RSA to
# ECDSA P-256 (a1626b6), cert generation still didn't complete on
# real hardware. openssl-util is now an explicit DEPENDS so the CLI
# must be present.
mkdir -p /etc/bubble
chmod 0700 /etc/bubble

if [ ! -f /etc/bubble/ui.pem ] || [ ! -f /etc/bubble/ui.key ]; then
	HOSTNAME=$(uci -q get bubbleui.ui.hostname || echo bubble.local)
	log "generating self-signed UI cert for CN=${HOSTNAME}"

	if ! command -v openssl >/dev/null 2>&1; then
		err "openssl CLI missing — cannot generate UI cert. Install openssl-util."
		exit 1
	fi

	# -addext subjectAltName=... is required: modern browsers
	# ignore the CN field and only accept the cert if the hostname
	# matches a SAN entry. Users hitting the router by IP will still
	# see the cert warning; we'll wire dynamic IP SANs in a later
	# revision once the dust settles.
	#
	# Capture openssl output to a temp file (busybox ash has no
	# pipefail, so piping straight to logger would mask a failed
	# openssl behind logger's success). On success we drop the log —
	# it's just ~2 KB of PRNG progress dots. On failure we replay it
	# through logger so the error is on the record.
	openssl_log=$(mktemp)
	if openssl req -x509 -newkey rsa:2048 -nodes \
		-keyout /etc/bubble/ui.key \
		-out    /etc/bubble/ui.pem \
		-days   28000 \
		-subj   "/CN=${HOSTNAME}" \
		-addext "subjectAltName=DNS:${HOSTNAME},DNS:bubble.local" \
		>"$openssl_log" 2>&1; then
		rm -f "$openssl_log"
	else
		rc=$?
		err "openssl cert generation failed (exit ${rc}) — UI will not load"
		# Replay openssl's output through logger so the failure mode
		# is on the record. -f reads from file; fall back to a raw
		# err line if -f isn't supported on this busybox build.
		logger -t bubbleui -p daemon.err -f "$openssl_log" 2>/dev/null || \
			err "openssl stderr (raw): $(cat "$openssl_log" 2>/dev/null)"
		rm -f "$openssl_log"
		exit 1
	fi

	chmod 0600 /etc/bubble/ui.key
	chmod 0644 /etc/bubble/ui.pem
	log "UI cert written to /etc/bubble/ui.pem"
else
	log "UI cert already present; leaving in place"
fi

# 2. LAN firewall: allow inbound 80/443 from the LAN zone so the
# user can reach the UI without manually editing the firewall.
# Idempotent — checks for our marker name first.
if ! uci -q show firewall | grep -q "name='Allow-BubbleUI-LAN'"; then
	uci -q batch <<-EOF
		add firewall rule
		set firewall.@rule[-1].name='Allow-BubbleUI-LAN'
		set firewall.@rule[-1].src='lan'
		set firewall.@rule[-1].proto='tcp'
		set firewall.@rule[-1].dest_port='80 443'
		set firewall.@rule[-1].target='ACCEPT'
		commit firewall
	EOF
fi

# 3. Tell nginx + firewall to pick up the new files. We use init.d
# rather than fw4/nginx -s because those calls work both on a fresh
# install and on a live system.
[ -x /etc/init.d/nginx ]   && /etc/init.d/nginx   reload   2>/dev/null || true
[ -x /etc/init.d/firewall ] && /etc/init.d/firewall reload 2>/dev/null || true

# Returning 0 tells procd to delete this script after a successful
# run, matching standard uci-defaults convention.
exit 0
