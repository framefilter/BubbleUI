#!/bin/sh /etc/rc.common
# bubble-vpnd — BubbleUI VPN daemon (DESIGN.md §6.2 / §11.5).

USE_PROCD=1
START=96
STOP=04

NAME=bubble-vpnd
PROG=/usr/sbin/bubble-vpnd

start_service() {
	. /lib/functions.sh
	config_load bubbleui

	local listen db probe_timeout probe_parallel
	config_get listen          server vpn_listen      '127.0.0.1:8766'
	config_get db              server vpn_db          '/etc/bubble/vpn.db'
	config_get probe_timeout   server probe_timeout   '1500ms'
	config_get probe_parallel  server probe_parallel  '16'

	mkdir -p "$(dirname "$db")"

	procd_open_instance "$NAME"
	procd_set_param command "$PROG" \
		-db "$db" \
		-listen "$listen" \
		-probe-timeout "$probe_timeout" \
		-probe-parallel "$probe_parallel"
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param file /etc/config/bubbleui
	procd_close_instance
}

reload_service() {
	stop
	start
}

service_triggers() {
	procd_add_reload_trigger bubbleui
}
