#!/bin/sh /etc/rc.common
# bubble-netd — BubbleUI network/firewall daemon (DESIGN.md §6.5).

USE_PROCD=1
START=97
STOP=03

NAME=bubble-netd
PROG=/usr/sbin/bubble-netd

start_service() {
	. /lib/functions.sh
	config_load bubbleui

	local listen window_duration captive_timeout
	config_get listen           server net_listen        '127.0.0.1:8767'
	config_get window_duration  server window_duration   '10m'
	config_get captive_timeout  server captive_timeout   '3s'

	procd_open_instance "$NAME"
	procd_set_param command "$PROG" \
		-listen "$listen" \
		-window-duration "$window_duration" \
		-captive-timeout "$captive_timeout"
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param file /etc/config/bubbleui
	procd_close_instance
}

reload_service() {
	stop
	start
}

service_triggers() {
	procd_add_reload_trigger bubbleui
}
