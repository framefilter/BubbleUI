#!/bin/sh /etc/rc.common
# bubble-hwd — BubbleUI hardware adapter daemon (DESIGN.md §13.7 / §14).

USE_PROCD=1
START=98
STOP=02

NAME=bubble-hwd
PROG=/usr/sbin/bubble-hwd

start_service() {
	. /lib/functions.sh
	config_load bubbleui

	local listen led_name vpn_status net_signin compose_interval
	config_get listen           server hw_listen         '127.0.0.1:8768'
	config_get led_name         server led_name          ''
	config_get vpn_status       server vpn_status_url    'http://127.0.0.1:8766/vpn/status'
	config_get net_signin       server net_signin_url    'http://127.0.0.1:8767/net/signin/status'
	config_get compose_interval server compose_interval  '5s'

	procd_open_instance "$NAME"
	procd_set_param command "$PROG" \
		-listen "$listen" \
		-vpn-status "$vpn_status" \
		-net-signin "$net_signin" \
		-compose-interval "$compose_interval"
	[ -n "$led_name" ] && procd_append_param command -led "$led_name"

	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param file /etc/config/bubbleui
	procd_close_instance
}

reload_service() {
	stop
	start
}

service_triggers() {
	procd_add_reload_trigger bubbleui
}
